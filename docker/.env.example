# Docker Compose environment variables for Isaac Sim + Web Viewer
# Copy this file to .env and uncomment/edit the values you need.

# --- Isaac Sim Image ---
# Use a prebuilt NGC image instead of the locally built isaac-sim-docker:latest.
# This skips the local build steps (prep_docker_build.sh and build_docker.sh).
# ISAAC_SIM_IMAGE=nvcr.io/nvidia/isaac-sim:6.0.1

# --- Persistent Data ---
# Host path for cache, config, logs, and data (must be owned by uid 1234).
# Use a full absolute path; ~ is not expanded by Docker Compose.
# ISAAC_SIM_DATA=/home/myuser/docker/isaac-sim

# --- Hub Workstation Cache ---
# Host path for the Hub Workstation Cache shared directory.
# Both the Hub container and Isaac Sim container mount this path to /var/cache/hub.
# Hub is for local workstation use only (bare-metal or local containers).
# ISAACSIM_HUB_CACHE_PATH=/home/myuser/.cache/ov/hub

# --- WebRTC Streaming ---
# The address THE BROWSER must reach for WebRTC signaling and media -- not the
# address the server binds to. 127.0.0.1 only works for a browser on this same
# machine.
#
# If you use Tailscale (or similar), prefer that IP over a LAN address: it works
# from the LAN *and* remotely, so there's nothing to change when you move.
#
# Consumed in TWO places, and they must agree:
#   1. web-viewer, at image BUILD time -- sed'd into src/main.ts as
#      signalingServer/mediaServer (see web-viewer/Dockerfile). What the browser dials.
#   2. isaac-sim, at container START -- becomes the livestream publicIp, i.e. the
#      ICE candidate Isaac advertises back to the browser.
#
# So a plain restart will NOT pick up a change here:
#   docker compose -p isim up -d --build web-viewer isaac-sim
#
# Symptom of getting this wrong: the viewer page loads fine but sits forever at
# "Waiting for stream" -- the page comes over HTTP on WEB_VIEWER_PORT, while the
# stream is dialing an address that doesn't exist on the browser's network. Looks
# like a WebRTC or GPU fault; it isn't. Fixing only the signaling side isn't
# enough either, since Isaac would still hand out the wrong candidate.
# ISAACSIM_HOST=127.0.0.1

# Signal port for WebRTC signaling (TCP).
# ISAACSIM_SIGNAL_PORT=49100

# Media port for WebRTC stream (UDP).
# ISAACSIM_STREAM_PORT=47998

# --- Web Viewer ---
# Port the web viewer listens on (override for multi-instance deployments).
# WEB_VIEWER_PORT=8210

# --- GPU ---
# GPU index to pin Isaac Sim to. Default is "all" (use all available GPUs).
# Set to a specific index (e.g. 0 or 1) for multi-instance with dedicated GPUs.
# GPU_DEVICE=all

# --- ROS 2 ---
# Domain ID shared with the lyrical container -- must match on both sides.
# ROS_DOMAIN_ID=0

# --- Lyrical container ---
# Host path for the white-crash ROS 2 workspace, mounted at /workspace.
# LYRICAL_WS=../white_crash_ws

# --- Scenes ---
# Host path for saved USD stage files, mounted at /isaac-sim/scenes.
# SCENES_DIR=../scenes
